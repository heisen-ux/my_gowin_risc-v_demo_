   1:../src/main.c **** /*
   2:../src/main.c ****  ******************************************************************************************
   3:../src/main.c ****  * @file		main.c
   4:../src/main.c ****  * @brief		Tang Nano 9K + Gowin PicoRV32 片上 SOPC 系统
   5:../src/main.c ****  *
   6:../src/main.c ****  *              功能1 流水灯   —— WBGPIO bit[5:0] 驱动板载 6 个 LED（低电平点亮
   7:../src/main.c ****  *              功能2 按键中断 —— S1 按键触发外部中断 IRQ20，切换流水灯方�
   8:../src/main.c ****  *              功能3 产生方波 —— CPU 定时器中断(IRQ0)翻转 GPIO bit[6]，输出约
   9:../src/main.c ****  *              功能4 串口通信 —— WBUART @115200：接收回显 + 状态信息输出
  10:../src/main.c ****  *
  11:../src/main.c ****  *              说明：仅修改本文件即可，其余库函数(bsp/lib)保持不变；
  12:../src/main.c ****  *                    硬件配套见 hardware/picorv32_sopc 工程。
  13:../src/main.c ****  ******************************************************************************************
  14:../src/main.c ****  */
  15:../src/main.c **** 
  16:../src/main.c **** #include "config.h"
  17:../src/main.c **** #include "picorv32.h"
  18:../src/main.c **** #include "firmware.h"
  19:../src/main.c **** #include "irq.h"
  20:../src/main.c **** #include "wbuart.h"
  21:../src/main.c **** #include "wbgpio.h"
  22:../src/main.c **** 
  23:../src/main.c **** /* 中断标志：由 bsp/irq.c 的 ISR 置位，主循环轮询处理 */
  24:../src/main.c **** uint8_t irq00_flag = 0;		// IRQ0   定时器中断
  25:../src/main.c **** uint8_t irq13_flag = 0;		// IRQ13  WBUART 接收中断
  26:../src/main.c **** uint8_t irq20_flag = 0;		// IRQ20  按键外部中断
  27:../src/main.c **** uint8_t irq21_flag = 0;		// IRQ21  保留（本设计未使用）
  28:../src/main.c **** 
  29:../src/main.c **** /* GPIO 位分配（硬件 IP 的 Gpio_Data_Width = 7） */
  30:../src/main.c **** #define GPIO_LED_MASK    (0x0000003FUL)	/* bit[5:0] -> 6 个 LED，低电平点亮 */
  31:../src/main.c **** #define GPIO_SQWAVE_BIT  (6)			/* bit[6]   -> 方波输出 */
  32:../src/main.c **** 
  33:../src/main.c **** /* 方波半周期定时器计数值：SYSCLKFREQ/2000 = 13500 个时钟(0.5ms)，
  34:../src/main.c ****  * 每次定时器中断翻转一次 -> 方波周期 1ms，频率约 1kHz。
  35:../src/main.c ****  * 若实测频率偏差，直接调整该值即可。 */
  36:../src/main.c **** #define SQ_WAVE_HALF_PERIOD  (SYSCLKFREQ / 2000)
  37:../src/main.c **** 
  38:../src/main.c **** /* 流水灯节奏：每 400 个定时器节拍（0.5ms * 400 = 200ms）移动一位 */
  39:../src/main.c **** #define FLOW_STEP_TICKS      (400)
  40:../src/main.c **** 
  41:../src/main.c **** static uint8_t  g_flow_dir = 1;		/* 1: 左移  0: 右移 */
  42:../src/main.c **** static uint8_t  g_flow_pos = 0;		/* 当前点亮的 LED 位 */
  43:../src/main.c **** static uint32_t g_gpio_out = 0;		/* 当前 GPIO 输出值 */
  44:../src/main.c **** static uint32_t g_tick     = 0;		/* 定时器节拍计数 */
  45:../src/main.c **** 
