module top (
  sys_clk,
  reset_n,
  uart_tx,
  uart_rx,
  gpio_io,
  key
)
;
input sys_clk;
input reset_n;
output uart_tx;
input uart_rx;
inout [6:0] gpio_io;
input key;
wire sys_clk_d;
wire reset_n_d;
wire key_d;
wire sys_rst_n;
wire slv_ext_ack_i;
wire clk_sys;
wire locked;
wire key_irq;
wire slv_ext_stb_o;
wire slv_ext_cyc_o;
wire VCC;
wire GND;
  IBUF sys_clk_ibuf (
    .O(sys_clk_d),
    .I(sys_clk) 
);
  IBUF reset_n_ibuf (
    .O(reset_n_d),
    .I(reset_n) 
);
  IBUF key_ibuf (
    .O(key_d),
    .I(key) 
);
  LUT2 sys_rst_n_s0 (
    .F(sys_rst_n),
    .I0(reset_n_d),
    .I1(locked) 
);
defparam sys_rst_n_s0.INIT=4'h8;
  LUT2 slv_ext_ack_i_s0 (
    .F(slv_ext_ack_i),
    .I0(slv_ext_stb_o),
    .I1(slv_ext_cyc_o) 
);
defparam slv_ext_ack_i_s0.INIT=4'h8;
  Gowin_rPLL u_pll (
    .sys_clk_d(sys_clk_d),
    .clk_sys(clk_sys),
    .locked(locked)
);
  key_debounce u_key_deb (
    .clk_sys(clk_sys),
    .key_d(key_d),
    .reset_n_d(reset_n_d),
    .locked(locked),
    .key_irq(key_irq)
);
  Gowin_PicoRV32_Top u_sopc (
    .uart_rx(uart_rx),
    .slv_ext_ack_i(slv_ext_ack_i),
    .key_irq(key_irq),
    .clk_sys(clk_sys),
    .sys_rst_n(sys_rst_n),
    .uart_tx(uart_tx),
    .slv_ext_stb_o(slv_ext_stb_o),
    .slv_ext_cyc_o(slv_ext_cyc_o),
    .gpio_io(gpio_io[6:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
